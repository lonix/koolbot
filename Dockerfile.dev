FROM node:24-alpine

WORKDIR /app

# Refresh the npm bundled in the base image so its tar/undici/ip-address/
# brace-expansion copies are patched. Pinned (not @latest) so the build cache
# cannot freeze it — keep in sync with NPM_VERSION in the production Dockerfile (#963).
ARG NPM_VERSION=12.1.0
RUN npm install -g "npm@${NPM_VERSION}" --no-audit --no-fund && npm cache clean --force

# Install development dependencies
COPY package*.json ./
RUN npm install --include=dev

# Copy source code
COPY . .

# Ensure scripts are available for development
RUN ls -la src/scripts/

# Expose ports for development
EXPOSE 3000

# Set environment variables
ENV NODE_ENV=development

# Start the application with hot reloading. `--watch` (Node >= 22) restarts the
# process whenever a loaded source file changes; docker-compose.dev.yml bind-mounts
# the repo at /app so host edits are what it sees.
CMD ["node", "--watch", "--watch-preserve-output", "--import", "./src/loader.js", "src/index.ts"]
