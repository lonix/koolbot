{
  "name": "koolbot",
  "version": "1.2.2",
  "type": "module",
  "description": "A modular Discord bot with voice channel management, activity tracking, quotes, stats, and fun easter eggs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --listFiles --listEmittedFiles",
    "start": "node dist/index.js",
    "dev": "node --watch --watch-preserve-output --import ./src/loader.js src/index.ts",
    "watch": "tsc --watch",
    "unregister-guild-commands": "node dist/unregister-guild-commands.js",
    "cleanup-global-commands": "node dist/scripts/cleanup-global-commands.js",
    "migrate-config": "node dist/scripts/migrate-config.js",
    "validate-config": "node dist/scripts/validate-config.js",
    "seed-sample-data": "node dist/scripts/seed-sample-data.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --coverage --maxWorkers=2",
    "coverage:drift": "node scripts/check-coverage-drift.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "check": "npm run build && npm run lint && npm run format:check",
    "check:all": "npm run build && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@discordjs/builders": "^1.14.1",
    "cron": "^4.4.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "js-yaml": "^4.3.2",
    "mongoose": "^9.10.0",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@jest/globals": "^30.5.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "~30.5.1",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "undici": "^7.29.0"
  },
  "overrides": {
    "undici": "$undici",
    "diff": "^8.0.3",
    "picomatch": "^4.0.4",
    "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
    "js-yaml": "$js-yaml",
    "markdown-it": "^14.2.0"
  }
}
